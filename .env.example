# ---- Server ----
PORT=3000
# A long random string used to sign login tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite file lives. On Render's free tier the filesystem is
# ephemeral, so data resets on redeploy/restart. Point this at a mounted
# disk (paid) or swap in Postgres for durable storage.
DB_PATH=./data/sakhi.sqlite

# Comma-separated list of allowed browser origins, or * to allow all.
CORS_ORIGIN=*

# ---- Email alerts (optional) ----
# If these are unset, alert emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sakhi Shield <alerts@example.com>

# ---- SMS alerts (optional) ----
# If these are unset, alert SMS are logged to the console instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000

# ---- Chat assistant (optional) ----
# If LLM_API_KEY is unset, /api/chat answers from a small built-in knowledge base
# instead of calling a model. Provider is 'openai' or 'groq' (both OpenAI-compatible).
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
